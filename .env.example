# Copy to .env and adjust. The server reads these at startup.

# Your GUS BIR USER_KEY. Request one (free) from regon_bir@stat.gov.pl.
# Leave unset to use the public TEST key against the anonymized test database.
REGON_API_KEY=abcde12345abcde12345

# Which GUS environment to hit: "test" (anonymized data) or "prod" (live data).
# Use "test" with the public test key; switch to "prod" only with a real USER_KEY.
REGON_ENV=test

# HTTP timeout in seconds.
REGON_TIMEOUT=30
